PORT=3000
# Image used for every sandbox. Build it with: npm run build:image
SANDBOX_IMAGE=node18-alpine-vite:latest
# Host port range handed out to containers (inclusive)
PORT_RANGE_START=41000
PORT_RANGE_END=41999
# Idle time before a sandbox is reaped (ms). Default 15 minutes.
SANDBOX_TTL_MS=900000
# How often the garbage collector sweeps (ms)
GC_INTERVAL_MS=30000
# Hard cap on concurrent sandboxes (16GB VPS @ 512MB each -> keep headroom)
MAX_SANDBOXES=20
# Memory / CPU per sandbox
SANDBOX_MEMORY_MB=512
SANDBOX_CPUS=0.5
# "none" = no network at all, or the name of an internal docker network
SANDBOX_NETWORK=sandbox_net
# Shared secret required in the x-api-key header (leave empty to disable auth)
API_KEY=
